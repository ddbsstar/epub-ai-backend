# Allowlist: never build from the parent workspace containing unrelated projects.
**
!package.json
!package-lock.json
!nest-cli.json
!tsconfig*.json
!prisma.config.ts
!prisma/
!prisma/**
!scripts/
!scripts/**
!src/
!src/**

# Regenerate the client inside Linux rather than copying local generated files.
src/generated/**
**/.env
**/.env.*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/work
**/work/**
**/credentials
**/credentials/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
