# Copy to the ignored .env. Defaults run without external services.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false
JSON_BODY_LIMIT_KB=256
# Omit SWAGGER_ENABLED to use development=true / production=false.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

DATABASE_ENABLED=false
DATABASE_URL=
DB_CONNECTION_LIMIT=5
REDIS_ENABLED=false
REDIS_URL=
QUEUE_ENABLED=false
QUEUE_PREFIX=epub-ai

QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_TIMEOUT_MS=30000
QWEN_MAX_OUTPUT_TOKENS=2048

# Shares the Qwen key/endpoint; historical V7/V8 tasks only.
# New V9 conversions never call visual review.
VISUAL_REVIEW_ENABLED=false
VISUAL_REVIEW_MODEL=
VISUAL_REVIEW_MAX_OUTPUT_TOKENS=1024
VISUAL_REVIEW_INPUT_TOKEN_BUDGET=32768
VISUAL_REVIEW_INPUT_PRICE_MICROS_PER_MILLION=800000
VISUAL_REVIEW_OUTPUT_PRICE_MICROS_PER_MILLION=2700000
VISUAL_REVIEW_PRICE_VERSION=qwen-visual-configured-v1

# Internal text-to-image API integration, independent of QWEN_ENABLED.
# The current provider uses this platform's key, not an official Aliyun region key.
# No public HTTP image-model proxy is registered. See docs/image-generation-api.md.
IMAGE_GENERATION_ENABLED=false
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://maas.qianwenaiapi.com/api/v1
IMAGE_MODEL=z-image-turbo
IMAGE_SIZE=1024*1024
IMAGE_TIMEOUT_MS=120000
IMAGE_DATA_DIR=
IMAGE_DOWNLOAD_HOSTS=dashscope-result-bj.oss-cn-beijing.aliyuncs.com,dashscope-result-sh.oss-cn-shanghai.aliyuncs.com,dashscope-result-sg.oss-ap-southeast-1.aliyuncs.com,dashscope-a717.oss-accelerate.aliyuncs.com
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=16777216
# Estimated CNY micros per image; prompt rewriting is always false.
IMAGE_PRICE_MICROS=100000
IMAGE_OPERATION_BUDGET_MICROS=100000
IMAGE_DAILY_BUDGET_MICROS=1000000
IMAGE_PRICE_VERSION=qianwen-platform-z-image-turbo-2026-10-21
# Whole-batch conservative admission ceiling (text planning + images), CNY micros.
ILLUSTRATION_BATCH_BUDGET_MICROS=1000000

# Phase A business processing is opt-in and local-development-only.
# Run API and npm run start:worker in separate terminals with identical paths.
PROCESSING_ENABLED=false
# Public typography beta is a separate explicit production profile. See docs/public-beta.md.
PROCESSING_PUBLIC_BETA_ENABLED=false
PROCESSING_BETA_OWNER_BOOK_LIMIT=5
PROCESSING_BETA_MAX_ACTIVE_RUNS=10
PROCESSING_BETA_STORAGE_MAX_MIB=1024
PROCESSING_BETA_RETENTION_HOURS=24
# Private, user-initiated feedback: local adapter only, fixed 24h expiry; no outbound messages.
PROCESSING_FEEDBACK_ENABLED=false
# AI business calls require both this flag and QWEN_ENABLED. No health probe calls a model.
PROCESSING_AI_ENABLED=false
# Budget units: 1 CNY = 1,000,000 micros. Defaults match qwen3.8-flash text pricing.
# Update the price version/rates together when choosing a different model or region.
AI_INPUT_TOKEN_BUDGET=32768
AI_MAX_MESSAGE_BYTES=24576
AI_MAX_RESPONSE_BYTES=98304
AI_RUN_BUDGET_MICROS=50000
AI_DAILY_BUDGET_MICROS=1000000
# Set false to disable monetary ceilings while retaining accounting/no-retry fences.
BUDGET_LIMITS_ENABLED=true
AI_INPUT_PRICE_MICROS_PER_MILLION=800000
AI_OUTPUT_PRICE_MICROS_PER_MILLION=2700000
AI_PRICE_VERSION=qwen3.8-flash-cn-2026-10-21
PROCESSING_REPOSITORY=local
PROCESSING_DATA_DIR=
PROCESSING_ALLOWED_ORIGIN=http://127.0.0.1:5173
PROCESSING_UPLOAD_MAX_MIB=100
PROCESSING_POLL_MS=1000
PROCESSING_LEASE_MS=30000
PROCESSING_OWNER_ACTIVE_LIMIT=1
PROCESSING_MAX_RUNS=1000
# Absolute EPUBCheck 5.4.0 jar path, installed separately; Java 11+ is required.
EPUBCHECK_JAR_PATH=
EPUBCHECK_JAVA_PATH=java
EPUBCHECK_TIMEOUT_MS=60000

# compose.dev.yml requires these values only when starting local dependencies.
# Choose local passwords, then set DATABASE_URL / REDIS_URL with URL encoding.
MYSQL_DATABASE=epub_ai
MYSQL_USER=epub_ai
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
